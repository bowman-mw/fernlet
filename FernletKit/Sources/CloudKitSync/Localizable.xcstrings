{
  "sourceLanguage" : "en",
  "strings" : {
    "cloudKit.error.confirmationRequired" : {
      "comment" : "Shown when a destructive iCloud deletion was requested without its confirmation step. DELETE is the word the user types; keep it uppercase and match whatever the confirmation field accepts in this language.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Confirm deletion by typing DELETE or using biometric verification again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirma el borrado escribiendo BORRAR o usando de nuevo la verificación biométrica."
          }
        }
      }
    },
    "cloudKit.error.notSignedIn" : {
      "comment" : "Shown when an iCloud data check or deletion is attempted with no iCloud account signed in.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sign in to iCloud to check or delete Fernlet cloud data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión en iCloud para comprobar o borrar los datos de Fernlet en la nube."
          }
        }
      }
    },
    "cloudKit.error.operationFailed" : {
      "comment" : "Wraps an underlying CloudKit failure so callers show one consistent alert. The argument is Apple's own error message, already localized by the system.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fernlet could not finish the iCloud operation: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fernlet no pudo terminar la operación de iCloud: %@"
          }
        }
      }
    },
    "multiDevice.syncOnWithoutAccount" : {
      "comment" : "Privacy & Data, multiple-devices note: the user chose iCloud sync but no iCloud account is signed in on this device.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "iCloud sync is on, but this iPhone isn't signed in to iCloud, so nothing is syncing yet. Your logs are safe on this iPhone and start syncing once you sign in to iCloud in the Settings app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización con iCloud está activada, pero este iPhone no tiene una sesión de iCloud iniciada, así que todavía no se sincroniza nada. Tus registros están a salvo en este iPhone y empiezan a sincronizarse cuando inicies sesión en iCloud en la app Ajustes."
          }
        }
      }
    },
    "persistence.error.primaryStoreUnavailable" : {
      "comment" : "Shown at startup when the local Core Data store will not open. The second sentence is the reassurance and is the most important half — keep it early and unambiguous; the third lists the two usual causes.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fernlet couldn't open your local records. Your data was not deleted. Unlock your device if it was just restarted, free up storage if needed, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fernlet no ha podido abrir tus registros locales. Tus datos no se han eliminado. Desbloquea tu dispositivo si acabas de reiniciarlo, libera espacio si hace falta e inténtalo de nuevo."
          }
        }
      }
    }
  },
  "version" : "1.0"
}