    "proximity.saveFailure.corruptedMany" : {
      "comment" : "Body of the photo-save failure alert when several pictures were being saved and every one failed to decode.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "None of the selected pictures could be saved. They may be corrupted — try choosing different ones."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fernlet no pudo guardar ninguna de las fotos seleccionadas. Puede que estén dañadas: intenta elegir otras."
          }
        }
      }
    },
    "proximity.saveFailure.corruptedOne" : {
      "comment" : "Body of the photo-save failure alert when exactly one picture was being saved and it failed to decode.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This picture couldn't be saved. It may be corrupted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fernlet no pudo guardar esta foto. Puede que esté dañada."
          }
        }
      }
    },
    "proximity.saveFailure.generic" : {
      "comment" : "Body of the photo-save failure alert when the cause is unknown, and also when a picture's bytes could not be read back from the encrypted cache at all.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Could not save to your photo library. Please try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fernlet no pudo guardar en tu fototeca. Inténtalo de nuevo."
          }
        }
      }
    },
    "proximity.saveFailure.ok" : {
      "comment" : "Cancel-role button dismissing the photo-save failure alert.",
