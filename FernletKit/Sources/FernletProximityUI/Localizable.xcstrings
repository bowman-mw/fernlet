    "proximity.review.endingSession" : {
      "comment" : "Status line on the photo review while Fernlet finishes leaving the in-person session that just ended; the buttons are disabled meanwhile. Takes at most a few seconds.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Ending the session..."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminando la sesión..."
          }
        }
      }
    },
    "proximity.review.explainer.pending" : {
      "comment" : "Explainer under the photo review sheet's title. Two promises, both load-bearing: nothing is saved (not to Fernlet, not to the camera roll) until the person chooses, and unkept photos are deleted from this phone.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nothing from this session is saved until you choose. Photos you don't keep are deleted from this phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se guarda nada de esta sesión hasta que elijas. Las fotos que no conserves se eliminan de este móvil."
          }
        }
      }
    },
    "proximity.review.keepSelected" : {
      "comment" : "Affirmative button of the photo review sheet: keeps the ticked pictures inside Fernlet. Copying them to the Photos library is a separate toggle, applied only after the keep.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep selected"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservar seleccionadas"
          }
        }
      }
    },
    "proximity.review.keepUnavailable" : {
      "comment" : "Line on the photo review sheet shown when the Keep button is disabled because the saved photo album cannot be read right now. Delete all still works.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keeping isn't possible right now because your saved photos can't be read. You can delete these, or choose later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora no se pueden conservar porque Fernlet no puede leer tus fotos guardadas. Puedes eliminar estas o decidir más tarde."
          }
        }
      }
    },
    "proximity.review.notNow" : {
      "comment" : "Text button at the top of the review shown when an in-person photo session ends. Hides the review without keeping or deleting anything; the photos keep waiting, unsaved, and the review comes back the next time Fernlet opens.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Not now"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora no"
          }
        }
      }
    },
    "proximity.review.report" : {
      "comment" : "Context-menu item and VoiceOver action on a photo another person shared in the session review grid. Opens the report sheet for the person who took it; reporting blocks them on this phone and removes the photo. The ellipsis says a sheet follows.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
