{
  "sourceLanguage" : "en",
  "strings" : {
    "friendPhoto.error.nothingSaved" : {
      "comment" : "Shown after saving shared friend photos when every image failed to decode, so no asset was created. Reports the real outcome rather than a false success.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "None of the selected pictures could be saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fernlet no pudo guardar ninguna de las fotos seleccionadas."
          }
        }
      }
    },
    "proximity.keepFriends.done" : {
      "comment" : "Button that closes the end-of-session sheet and saves the keep-as-friend choices.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Done"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OK"
          }
        }
      }
    },
    "proximity.keepFriends.explainer" : {
      "comment" : "Body under the keep-as-friends heading. Must keep saying that the choice is private to this user and that the other person is never told either way.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Friends stay on your list for good vibes and future hangouts. This is just for you — they won't be notified either way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus amigos se quedan en tu lista para el buen rollo y las próximas quedadas. Es solo para ti: no se les avisará, elijas lo que elijas."
          }
        }
      }
    },
    "proximity.keepFriends.keep" : {
      "comment" : "Chip beside one person met during the session, in its unselected state. Tapping it keeps them as a friend.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservar"
          }
        }
      }
    },
    "proximity.keepFriends.keeping" : {
      "comment" : "The keep-as-friend chip in its selected state. Present participle: it describes what will happen, not a completed action.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keeping"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se queda"
          }
        }
      }
    },
    "proximity.keepFriends.metByTapping" : {
      "comment" : "Under a person's name in the keep-as-friends sheet, when the two of you met by holding your phones together. Lowercase, a quiet second line (Spanish: os conocisteis juntando teléfonos).",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "met by tapping phones"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "os conocisteis juntando los móviles"
          }
        }
      }
    },
    "proximity.keepFriends.sectionTitle" : {
      "comment" : "Heading of the list of people met during the session, each with a keep-or-not choice.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep as friends?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Conservar como amigos?"
          }
        }
      }
    },
    "proximity.keepFriends.sessionTitle" : {
      "comment" : "Warm title of the sheet shown when an in-person session ends without photos, asking whether to keep the people met as friends.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nice hangout!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Qué buena quedada!"
          }
        }
      }
    },
    "proximity.review.alsoSaveToPhotos.toggle" : {
      "comment" : "Toggle on the photo review sheet, off each time. When on, the photos the person keeps are also copied to the system Photos library after they are kept in Fernlet.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Also save kept photos to Photos"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardar también las conservadas en Fotos"
          }
        }
      }
    },
    "proximity.review.answerFailed" : {
      "comment" : "Inline message on the photo review sheet when the person's keep/delete answer could not be applied. The photos are still waiting, untouched.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Couldn't save your choice. Nothing was lost. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fernlet no ha podido guardar tu elección. No se ha perdido nada. Inténtalo de nuevo."
          }
        }
      }
    },
    "proximity.review.deleteAll" : {
      "comment" : "Destructive button of the photo review sheet. The count is deliberate: it turns a mis-tap into a visible amount of loss.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Delete all %lld"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Delete all %lld"
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Eliminar %lld foto"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Eliminar las %lld"
                }
              }
            }
          }
        }
      }
    },
    "proximity.review.deleteConfirm.message" : {
      "comment" : "Body of the confirmation before deleting the pictures under review: only this phone's copies go.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "They'll be removed from this phone. Friends keep their own copies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán de este móvil. Tus amigos conservan sus propias copias."
          }
        }
      }
    },
    "proximity.review.deleteConfirm.oneTitle" : {
