{
  "sourceLanguage" : "en",
  "strings" : {
    "labelScan.error.imageConversionFailed" : {
      "comment" : "Shown when a captured image could not be converted for Vision. 'Please try again' is literal — a retry usually works.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Could not process the image. Please try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fernlet no pudo procesar la imagen. Inténtalo de nuevo."
          }
        }
      }
    },
    "labelScan.error.noTextFound" : {
      "comment" : "Shown when OCR found no text on a nutrition-label photo. The second sentence is the recovery and must stay actionable.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Could not read any text from that image. Try a clearer photo of the nutrition label."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fernlet no pudo leer ningún texto en esa imagen. Prueba con una foto más nítida de la información nutricional."
          }
        }
      }
    },
    "notification.dailyCheckIn.body" : {
      "comment" : "Body of the once-a-day reminder notification. Must stay unconditional — care counts regardless of how the day went.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "However today went, a small note of care still counts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Como haya ido el día, una pequeña nota de cuidado también cuenta."
          }
        }
      }
    },
    "notification.dailyCheckIn.title" : {
      "comment" : "Title of the once-a-day reminder notification. An invitation, never a streak warning or a nag.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A gentle check-in"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un momento para ti"
          }
        }
      }
    },
    "notification.sessionMessage.body" : {
      "comment" : "Body of the session-message notification. The disappearance is the important half: session chat is not stored anywhere after the session.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open Fernlet to reply — session messages disappear when the session ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abre Fernlet para responder: los mensajes de la sesión desaparecen cuando termina la sesión."
          }
        }
      }
    },
    "notification.sessionMessage.title" : {
      "comment" : "Title of the notification for a mesh session message that arrived while the app was backgrounded. The argument is the sender's sanitized display name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "New message from %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nuevo mensaje de %@"
          }
        }
      }
    },
    "notification.sessionMessage.unknownSender" : {
      "comment" : "Stands in for a session peer whose name sanitized away to nothing. Reads inside the sentence 'New message from …', so it is lower-case.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "a friend"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "un amigo"
          }
        }
      }
    },
    "notification.workoutCue.holdEnded.body" : {
      "comment" : "Body of the hold-ended workout cue. Calm wording; the run moves on when the person opens Fernlet.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Ease out of it. The next step is ready when you are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Suelta con calma. El siguiente paso te espera cuando quieras."
          }
        }
      }
    },
    "notification.workoutCue.holdEnded.title" : {
      "comment" : "Title of the in-session cue delivered when a timed hold (a stretch, a plank, a carry) runs out while Fernlet is in the background.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold's done"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ya puedes soltar"
          }
        }
      }
    },
    "notification.workoutCue.restEnded.body" : {
      "comment" : "Body of the rest-ended workout cue. An invitation, never a command or a hurry.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Start your next set when you're ready."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza la siguiente serie cuando estés ^[listo](inflect: true)."
          }
        }
      }
    },
    "notification.workoutCue.restEnded.title" : {
      "comment" : "Title of the in-session cue delivered when a guided workout's rest timer reaches zero while Fernlet is in the background. Gentle: the rest waits for the person; this only says the timer ran out.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Rest's over"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Terminó el descanso"
          }
        }
      }
    },
    "notification.workoutCue.segmentEnded.body" : {
      "comment" : "Body of the cardio segment-ended workout cue. Calm, never a hurry; the guided run waits on that part until the person opens Fernlet.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Change your pace when you're ready. The next part starts when you open Fernlet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia el ritmo cuando estés ^[listo](inflect: true). La siguiente parte empieza cuando abras Fernlet."
          }
        }
      }
    },
    "notification.workoutCue.segmentEnded.title" : {
      "comment" : "Title of the in-session cue delivered when one timed part of a guided cardio session (an interval's hard or easy part, or a steady stretch of cardio) runs out while Fernlet is in the background.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Time's up on this part"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se acabó el tiempo de esta parte"
          }
        }
      }
    },
    "weather.gentlerDay.prompt" : {
      "comment" : "Home card on a heavy, gloomy weather day (rain, snow, fog, cloud). An invitation to self-kindness, never an instruction; 'a small, warm thing' is any small act of care.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The weather outside is heavy today. Be a little gentler with yourself — a small, warm thing still counts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hoy el clima está pesado. Sé un poco más amable contigo: algo pequeño y cálido también cuenta."
          }
        }
      }
    }
  },
  "version" : "1.0"
}