  "strings" : {
    "fernletVoice.aiResting" : {
      "comment" : "Settings, AI section: today's on-device AI budget is used up; it resets at midnight",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The quiet helper is resting for today. Fernlet will use local care until tomorrow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El ayudante silencioso descansa por hoy. Hasta mañana, Fernlet usará sus alternativas locales."
          }
        }
      }
    },
    "fernletVoice.aiUnavailable" : {
      "comment" : "Settings, AI section: the on-device AI ('the quiet helper') is switched off",
