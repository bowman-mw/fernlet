    "health.status.revokeInstructions" : {
      "comment" : "Settings › Health: how to take back a Health permission. The placeholder is a permission kind read mid-sentence. 'Settings > Privacy & Security > Health > Fernlet' is the iOS Settings path: use the names iOS shows in this language.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "To revoke %@ access, open Settings > Privacy & Security > Health > Fernlet. iOS does not allow apps to revoke Health permissions directly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Para revocar este acceso (%@), abre Configuración > Privacidad y seguridad > Salud > Fernlet. iOS no permite que las apps revoquen los permisos de Salud directamente."
          }
        }
      }
    },
