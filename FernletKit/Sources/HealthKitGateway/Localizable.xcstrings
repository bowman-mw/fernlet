    "health.error.cacheClearerUnavailable" : {
      "comment" : "Shown when turning Health off failed. The causal 'so it did not disable' is load-bearing: disabling fails closed rather than leaving opted-out data behind, and the user needs to know it is still on.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fernlet could not clear cached HealthKit values, so it did not disable HealthKit. Please try again."
          }
        }
      }
    },
    "health.error.healthDataUnavailable" : {
      "comment" : "Shown when the device has no Health store, or when a Fernlet Health opt-in gate is closed.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Health data is not available on this device."
          }
        }
      }
    },
    "health.error.invalidMeasurement" : {
      "comment" : "Shown when an offered body measurement was zero, negative or not finite, so nothing was written to Apple Health.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Those height and weight values do not look right, so Fernlet did not save them to Health."
          }
        }
      }
    },
    "health.error.missingHealthType" : {
      "comment" : "Diagnostic shown when HealthKit returns no type object for an identifier. The argument is Apple's untranslated type identifier and must stay verbatim.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fernlet could not create the HealthKit type for %@."
          }
        }
      }
    },
    "health.error.sharingTurnedOff" : {
      "comment" : "Shown when Fernlet refused to write to Apple Health because the user turned Fernlet's Health sharing off (the master switch or this kind of data). Nothing was written.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sharing with Apple Health is turned off in Fernlet, so nothing was saved to Health. You can turn it on in Settings › Health."
          }
        }
      }
    },
    "health.status.accessUpdated" : {
      "comment" : "Settings › Health status line after the Health permission sheet closed. The placeholder is a permission kind read mid-sentence, e.g. 'body profile'.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
