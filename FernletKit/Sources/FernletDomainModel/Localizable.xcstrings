    "exercise.supineTwist.cue2" : {
      "comment" : "Supine twist: how-to cue 2 of 5, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Streck die Arme zur Seite aus."
