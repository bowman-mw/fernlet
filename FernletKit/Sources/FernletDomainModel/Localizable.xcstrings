    },
    "exercise.superman.cue2" : {
      "comment" : "Superman: how-to cue 2 of 4, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Heb Arme, Brust und Beine ein Stück vom Boden ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lift your arms, chest and legs a little off the floor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Despega un poco del suelo los brazos, el pecho y las piernas."
