    "exercise.supineTwist.cue1" : {
      "comment" : "Supine twist: how-to cue 1 of 5, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Leg dich auf den Rücken, die Knie gebeugt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lie on your back with your knees bent."
          }
