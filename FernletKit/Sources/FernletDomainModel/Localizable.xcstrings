    "exercise.turkishGetUp.cue1" : {
      "comment" : "Turkish get-up: how-to cue 1 of 5, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Leg dich hin und halte die Kettlebell gerade über der Schulter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lie down holding the kettlebell straight up over your shoulder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Acuéstate con la kettlebell en vertical sobre el hombro, brazo estirado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Allonge-toi en tenant la kettlebell bras tendu au-dessus de l'épaule."
          }
        }
      }
    },
    "exercise.turkishGetUp.cue2" : {
      "comment" : "Turkish get-up: how-to cue 2 of 5, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Behalte die Kettlebell die ganze Zeit im Blick."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep your eyes on the kettlebell the whole way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantén la mirada en la kettlebell todo el tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Garde les yeux sur la kettlebell tout du long."
          }
        }
      }
    },
    "exercise.turkishGetUp.cue3" : {
      "comment" : "Turkish get-up: how-to cue 3 of 5, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Roll auf den Ellbogen, dann auf die Hand, und heb die Hüfte an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Roll to your elbow, then your hand, then lift your hips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apóyate en el codo, luego en la mano, y sube la cadera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Roule sur le coude, puis sur la main, puis monte les hanches."
          }
        }
      }
    },
    "exercise.turkishGetUp.cue4" : {
      "comment" : "Turkish get-up: how-to cue 4 of 5, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Schwing das Bein unter dich in den Kniestand und steh dann auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sweep your leg under you to kneel, then stand up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pasa la pierna por debajo para arrodillarte y luego ponte de pie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Passe la jambe sous toi pour te mettre à genou, puis relève-toi."
          }
        }
      }
    },
    "exercise.turkishGetUp.cue5" : {
      "comment" : "Turkish get-up: how-to cue 5 of 5, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geh jeden Schritt langsam rückwärts, um dich wieder hinzulegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reverse each step slowly to lie back down."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deshaz cada paso despacio para volver a acostarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Refais chaque étape à l'envers, lentement, pour te rallonger."
          }
        }
      }
    },
    "exercise.turkishGetUp.easier" : {
      "comment" : "Turkish get-up: an easier version, as a short instruction",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Üb die Schritte ohne Gewicht oder mit einem Schuh, der auf deiner Faust balanciert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Practice the steps with no weight, or with a shoe balanced on your fist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Practica los pasos sin peso, o con un zapato en equilibrio sobre el puño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entraîne les étapes sans charge, ou avec une chaussure en équilibre sur ton poing."
          }
        }
      }
    },
    "exercise.turkishGetUp.mistake" : {
      "comment" : "Turkish get-up: the one common mistake to avoid, as a short phrase",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Durch die Schritte hetzen und den Arm aus der Senkrechten kippen lassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Rushing through the steps and letting the arm drift off vertical."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hacer los pasos con prisa y dejar que el brazo pierda la vertical."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Enchaîner les étapes trop vite et laisser le bras quitter la verticale."
          }
        }
      }
    },
    "exercise.turkishGetUp.name" : {
