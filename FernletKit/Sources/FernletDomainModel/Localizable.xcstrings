    "exercise.superman.cue1" : {
      "comment" : "Superman: how-to cue 1 of 4, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Leg dich auf den Bauch, die Arme nach vorn gestreckt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lie face down with your arms reaching forward."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Acuéstate boca abajo con los brazos estirados al frente."
          }
