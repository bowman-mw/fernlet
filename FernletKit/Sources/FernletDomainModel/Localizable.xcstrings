    },
    "exercise.superman.cue3" : {
      "comment" : "Superman: how-to cue 3 of 4, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halte den Nacken lang und schau auf den Boden."
