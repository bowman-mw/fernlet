    },
    "exercise.supineTwist.cue5" : {
      "comment" : "Supine twist: how-to cue 5 of 5, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Atme langsam, hol die Knie zurück und wechsle die Seite."
          }
