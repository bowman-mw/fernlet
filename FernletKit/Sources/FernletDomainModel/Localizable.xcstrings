    "exercise.chinUp.cue1" : {
      "comment" : "Chin-up: how-to cue 1 of 4, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Häng dich schulterbreit an die Stange, Handflächen zu dir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hang with hands shoulder-width apart, palms facing you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuélgate con las manos al ancho de los hombros, palmas hacia ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Suspends-toi, mains largeur d'épaules, paumes vers toi."
          }
        }
      }
    },
    "exercise.chinUp.cue2" : {
      "comment" : "Chin-up: how-to cue 2 of 4, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spann den Bauch an und halte die Beine ruhig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Brace your stomach and keep your legs still."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tensa el abdomen y mantén las piernas quietas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gaine les abdos et garde les jambes immobiles."
          }
        }
      }
    },
    "exercise.chinUp.cue3" : {
      "comment" : "Chin-up: how-to cue 3 of 4, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zieh die Brust zur Stange, Ellbogen nach unten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pull your chest toward the bar, elbows driving down."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lleva el pecho hacia la barra, empujando los codos hacia abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tire la poitrine vers la barre, coudes vers le bas."
          }
        }
      }
    },
    "exercise.chinUp.cue4" : {
      "comment" : "Chin-up: how-to cue 4 of 4, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Senk dich langsam ab, bis die Arme wieder gestreckt sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lower slowly until your arms are straight again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Baja despacio hasta volver a estirar los brazos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Redescends lentement jusqu'à tendre de nouveau les bras."
          }
        }
      }
    },
    "exercise.chinUp.easier" : {
      "comment" : "Chin-up: an easier version, as a short instruction",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spring nach oben und senk dich langsam ab, oder nutze ein Hilfsband."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Jump to the top and lower yourself slowly, or use an assisting band."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Salta hasta arriba y baja despacio, o usa una banda de asistencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Saute en position haute et redescends lentement, ou utilise un élastique d'assistance."
          }
        }
      }
    },
    "exercise.chinUp.mistake" : {
      "comment" : "Chin-up: the one common mistake to avoid, as a short phrase",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halbe Wiederholungen machen, bei denen die Arme unten nie ganz gestreckt sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Doing half reps that never return to straight arms at the bottom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hacer medias repeticiones que nunca vuelven abajo con los brazos estirados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faire des demi-répétitions sans jamais revenir bras tendus en bas."
          }
        }
      }
    },
