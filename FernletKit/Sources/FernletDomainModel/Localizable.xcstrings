    "exercise.overheadPress.cue1" : {
      "comment" : "Overhead press: how-to cue 1 of 5, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Füße hüftbreit, die Stange liegt vorn auf den Schultern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Stand with feet hip-width apart, bar resting on your front shoulders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pies al ancho de cadera, barra apoyada en la parte delantera de los hombros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Debout, pieds largeur de hanches, barre posée sur l'avant des épaules."
          }
