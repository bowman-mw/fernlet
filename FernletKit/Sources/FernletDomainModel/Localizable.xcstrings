    "exercise.clamshell.cue1" : {
      "comment" : "Clamshell: how-to cue 1 of 4, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Leg dich auf die Seite, Knie gebeugt und übereinander."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lie on your side with your knees bent and stacked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Acuéstate de lado con las rodillas dobladas, una sobre otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Allonge-toi sur le côté, genoux pliés et superposés."
          }
        }
      }
    },
    "exercise.clamshell.cue2" : {
      "comment" : "Clamshell: how-to cue 2 of 4, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halte die Füße zusammen und die Hüften übereinander."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep your feet together and your hips stacked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mantén los pies juntos y una cadera sobre la otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Garde les pieds joints et les hanches superposées."
          }
        }
      }
    },
    "exercise.clamshell.cue3" : {
      "comment" : "Clamshell: how-to cue 3 of 4, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Heb das obere Knie, ohne die Hüfte nach hinten zu drehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lift the top knee without rolling your hips back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sube la rodilla de arriba sin girar la cadera hacia atrás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lève le genou du dessus sans basculer le bassin en arrière."
          }
        }
      }
    },
    "exercise.clamshell.cue4" : {
      "comment" : "Clamshell: how-to cue 4 of 4, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Senk es langsam ab und wechsle nach deinen Wiederholungen die Seite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lower it slowly, then switch sides after your reps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bájala despacio y cambia de lado al terminar las repeticiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Redescends-le lentement, puis change de côté après tes répétitions."
          }
        }
      }
    },
    "exercise.clamshell.easier" : {
      "comment" : "Clamshell: an easier version, as a short instruction",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
