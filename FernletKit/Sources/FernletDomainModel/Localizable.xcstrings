    "exercise.dip.cue1" : {
      "comment" : "Dip: how-to cue 1 of 5, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Halte dich mit gestreckten Armen an den Holmen, Schultern nach unten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Hold the bars with straight arms, shoulders pressed down."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sujeta las barras con los brazos estirados y los hombros abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tiens les barres bras tendus, épaules abaissées."
          }
        }
      }
    },
    "exercise.dip.cue2" : {
      "comment" : "Dip: how-to cue 2 of 5, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lehn dich etwas nach vorn und halte die Ellbogen nach hinten gerichtet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lean forward a little and keep your elbows tucked back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inclínate un poco hacia delante y mantén los codos hacia atrás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Penche-toi un peu en avant et garde les coudes vers l'arrière."
          }
        }
      }
    },
    "exercise.dip.cue3" : {
      "comment" : "Dip: how-to cue 3 of 5, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Senk dich langsam ab, bis die Oberarme etwa parallel zum Boden sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lower slowly until your upper arms are about parallel to the floor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Baja despacio hasta que los brazos queden casi paralelos al suelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Descends lentement jusqu'à avoir le haut des bras presque parallèle au sol."
          }
        }
      }
    },
    "exercise.dip.cue4" : {
      "comment" : "Dip: how-to cue 4 of 5, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geh nur so tief, wie es sich für deine Schultern gut anfühlt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Only go as deep as your shoulders feel comfortable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Baja solo hasta donde tus hombros estén cómodos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ne descends que tant que tes épaules restent à l'aise."
          }
        }
      }
    },
    "exercise.dip.cue5" : {
      "comment" : "Dip: how-to cue 5 of 5, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Drück dich ohne Beinschwung zurück in die gestreckten Arme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Press back up to straight arms without swinging your legs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sube hasta estirar los brazos sin balancear las piernas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Remonte bras tendus sans balancer les jambes."
          }
        }
      }
    },
    "exercise.dip.easier" : {
