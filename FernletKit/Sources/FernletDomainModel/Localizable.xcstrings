    "exercise.wideLegForwardFold.cue5" : {
      "comment" : "Wide-leg forward fold: how-to cue 5 of 5, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
