    "exercise.supineTwist.cue3" : {
      "comment" : "Supine twist: how-to cue 3 of 5, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lass beide Knie langsam zu einer Seite sinken."
