    "exercise.clean.cue1" : {
      "comment" : "Clean: how-to cue 1 of 5, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lern es mit einem Coach oder zuerst mit der leeren Stange."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Learn it with a coach, or with an empty bar first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apréndela con un entrenador, o primero con la barra vacía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apprends-le avec un coach, ou d'abord avec la barre à vide."
          }
