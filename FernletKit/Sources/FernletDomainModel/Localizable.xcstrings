    },
    "exercise.clean.cue2" : {
      "comment" : "Clean: how-to cue 2 of 5, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beginne wie beim Kreuzheben, Stange über der Fußmitte, Rücken gerade."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Start like a deadlift, bar over mid-foot, back flat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Empieza como en un peso muerto: barra sobre la mitad del pie, espalda recta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pars comme un soulevé de terre, barre au-dessus du milieu du pied, dos plat."
          }
        }
      }
    },
    "exercise.clean.cue3" : {
      "comment" : "Clean: how-to cue 3 of 5, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Heb die Stange nah am Körper über die Knie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lift the bar past your knees, keeping it close."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sube la barra más allá de las rodillas, pegada al cuerpo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Monte la barre au-delà des genoux en la gardant près du corps."
          }
        }
      }
    },
    "exercise.clean.cue4" : {
      "comment" : "Clean: how-to cue 4 of 5, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spring mit der Hüfte und zieh dich unter die Stange."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Jump with your hips and pull yourself under the bar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Salta con la cadera y métete bajo la barra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Saute avec les hanches et passe sous la barre."
          }
        }
      }
    },
    "exercise.clean.cue5" : {
      "comment" : "Clean: how-to cue 5 of 5, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fang sie vorn auf den Schultern, die Ellbogen hoch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Catch it on your front shoulders with your elbows high."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Recíbela sobre la parte delantera de los hombros, con los codos altos."
          }
