    "exercise.facePull.cue1" : {
      "comment" : "Face pull: how-to cue 1 of 5, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stell ein Seil auf Höhe der oberen Brust oder etwas höher ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Set a rope at upper-chest height or a little higher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pon la cuerda a la altura de la parte alta del pecho, o algo más."
