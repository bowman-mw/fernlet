    "exercise.abWheel.cue1" : {
      "comment" : "Ab wheel: how-to cue 1 of 4, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Knie dich auf eine weiche Matte, Hände am Rad unter den Schultern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Kneel on a soft mat, hands on the wheel under your shoulders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arrodíllate sobre una colchoneta, con las manos en la rueda bajo los hombros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "À genoux sur un tapis moelleux, mains sur la roue sous les épaules."
          }
        }
      }
    },
    "exercise.abWheel.cue2" : {
      "comment" : "Ab wheel: how-to cue 2 of 4, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spann den Bauch an und richte das Becken leicht auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Brace your stomach and tuck your hips slightly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tensa el abdomen y mete un poco la cadera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gaine les abdos et rentre légèrement le bassin."
          }
        }
      }
    },
    "exercise.abWheel.cue3" : {
      "comment" : "Ab wheel: how-to cue 3 of 4, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Roll langsam nach vorn, nur so weit, wie der Rücken gerade bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Roll forward slowly, only as far as your back stays flat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rueda hacia delante despacio, solo mientras la espalda siga recta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Roule lentement vers l'avant, tant que ton dos reste plat."
          }
        }
      }
    },
    "exercise.abWheel.cue4" : {
      "comment" : "Ab wheel: how-to cue 4 of 4, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zieh dich mit dem Bauch zurück, nicht mit der Hüfte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pull back with your stomach, not your hips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vuelve tirando con el abdomen, no con la cadera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Reviens en tirant avec les abdos, pas avec les hanches."
          }
        }
      }
    },
    "exercise.abWheel.easier" : {
      "comment" : "Ab wheel: an easier version, as a short instruction",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Roll nur ein kurzes Stück oder auf eine Wand zu, die dich stoppt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Roll out a short distance, or roll toward a wall that stops you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rueda una distancia corta o hacia una pared que te detenga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Roule sur une courte distance, ou vers un mur qui t'arrête."
          }
        }
      }
    },
    "exercise.abWheel.mistake" : {
      "comment" : "Ab wheel: the one common mistake to avoid, as a short phrase",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zu weit hinausrollen, sodass der untere Rücken durchhängt und ins Hohlkreuz geht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Rolling out too far so the lower back sags and arches."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rodar demasiado lejos, de modo que la zona lumbar se hunde y se arquea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rouler trop loin, si bien que le bas du dos s'affaisse et se cambre."
          }
        }
      }
    },
    "exercise.abWheel.name" : {
      "comment" : "Exercise name shown on screen (exercise)",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bauchroller"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Ab wheel"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rueda abdominal"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Roue abdominale"
          }
        }
      }
    },
    "exercise.arnoldPress.cue1" : {
      "comment" : "Arnold press: how-to cue 1 of 4, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sitz aufrecht, Kurzhanteln auf Schulterhöhe, Handflächen zu dir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sit tall with dumbbells at shoulder height, palms facing you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Siéntate con la espalda recta, mancuernas en los hombros y palmas hacia ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Assieds-toi le dos droit, haltères à hauteur d'épaules, paumes vers toi."
          }
        }
      }
    },
    "exercise.arnoldPress.cue2" : {
      "comment" : "Arnold press: how-to cue 2 of 4, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Drück nach oben und dreh dabei die Handflächen nach vorn."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Press up while turning your palms to face forward."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Empuja hacia arriba mientras giras las palmas hacia delante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pousse vers le haut en tournant les paumes vers l'avant."
          }
        }
      }
    },
    "exercise.arnoldPress.cue3" : {
      "comment" : "Arnold press: how-to cue 3 of 4, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Am Ende sind die Arme über dem Kopf gestreckt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Finish with your arms straight overhead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Termina con los brazos estirados por encima de la cabeza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Termine bras tendus au-dessus de la tête."
          }
        }
      }
    },
    "exercise.arnoldPress.cue4" : {
      "comment" : "Arnold press: how-to cue 4 of 4, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dreh beim langsamen Absenken wieder zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reverse the turn as you lower slowly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Deshaz el giro mientras bajas despacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fais la rotation inverse en redescendant lentement."
          }
        }
      }
    },
    "exercise.arnoldPress.easier" : {
      "comment" : "Arnold press: an easier version, as a short instruction",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
