    "exercise.wideLegForwardFold.cue4" : {
      "comment" : "Wide-leg forward fold: how-to cue 4 of 5, a short imperative step",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spür die Dehnung hinten an den Oberschenkeln und an deren Innenseiten."
