{
  "sourceLanguage" : "en",
  "strings" : {
    "recipeImport.error.aiBudgetExhausted" : {
      "comment" : "Shown when today's on-device AI budget is spent. Deliberately gentle and first-person: this clears at midnight and the import retries itself, so it is a reassurance rather than a failure.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The quiet helper is resting for today. I'll try this recipe again tomorrow."
          }
        }
      }
    },
    "recipeImport.error.emptyHTML" : {
      "comment" : "Shown when a recipe page loaded but its body decoded to empty or whitespace-only text.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The page did not return readable HTML."
          }
        }
      }
    },
    "recipeImport.error.fetchFailed" : {
      "comment" : "Shown when the network fetch of a recipe page failed, returned a non-2xx status, or was not HTML.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Could not fetch that recipe page."
          }
        }
      }
    },
    "recipeImport.error.incompleteRecipe" : {
      "comment" : "Shown when on-device extraction returned something, but without a name or any ingredients.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The extracted recipe was missing a name or ingredients."
          }
        }
      }
    },
    "recipeImport.error.invalidURL" : {
      "comment" : "Shown when a pasted recipe link is not https, has no host, or resolves to a private address.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pasteboard does not contain a valid URL."
          }
        }
      }
    },
    "recipeImport.error.modelUnavailable" : {
      "comment" : "Shown when this device cannot run on-device extraction at all — a permanent limit, not today's budget.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "On-device recipe extraction is not available on this device."
          }
        }
      }
    },
    "recipeImport.error.noRecipeFound" : {
      "comment" : "Shown when a page carried no structured recipe and on-device extraction was disabled or found nothing.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No recipe could be extracted from that page."
          }
        }
      }
    }
  },
  "version" : "1.0"
}