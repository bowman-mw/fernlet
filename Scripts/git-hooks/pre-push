#!/bin/bash
#
# pre-push — run the walls' local checks before code leaves the machine (WI-3,
# Docs/Security-Hardening-Plan-2026-06-27.md). The always-available complement to the CI workflow.
#
# Install once per clone:  Scripts/install-git-hooks.sh   (points core.hooksPath at Scripts/git-hooks)
# Bypass one leg once (sparingly; CI still enforces it):  SKIP_P10_SCAN=1, SKIP_S3_WALL_CHECK=1 or
# SKIP_MACOS_BUILD_CHECK=1 before `git push`. Each skips its own leg only.
#
# Three legs, in this order, and no leg's skip or relevance check ends another:
#
#   1. The Power-of-10 mechanical scan (Scripts/power-of-10-scan.py, pure Python, ~2 s) runs on EVERY
#      push regardless of what changed — it is too cheap to gate.
#   2. The S3 privacy-wall check (Scripts/spm-wall-check.sh, a full Xcode build) runs ONLY when the push
#      touches wall-relevant code: the package manifest, any package source, the AI-facing app files the
#      grep-wall covers, or the wall script itself. The pbxproj, privacy manifests, and the no-tracking
#      wall's own test are in the list too — they are the inputs to the SECOND wall
#      (Docs/No-Tracking-Wall.md), whose dependency and destination allowlists a project-file edit can
#      silently widen. Since the strict build also enforces Power-of-10 rule 10 (warnings are errors,
#      package warnings un-suppressed — Docs/Power-of-10-Swift.md §R10), every Swift file in the tree is
#      wall-relevant too: the widgets, the share extension, and every test target can each introduce a
#      warning. Since ProximityKit plan step A0.8 the build goes through Fernlet.xcworkspace, so the
#      workspace and the shared schemes (whose testables decide what it compiles) are wall-relevant
#      too; and since A1.3, when ProximityKit became a pinned dependency (exactly 0.1.0, from its own
#      repository), both Package.resolved files are, since the revision they pin is code the strict
#      build compiles.
#   3. The macOS build check (Scripts/macos-build-check.sh: the Mac-ready set built for native macOS 26
#      with warnings as errors, plan step A0.6) runs ONLY when the push touches what that build reads:
#      the package manifest and its resolved file, the three modules its `MacReady` product names
#      (FernletCrypto, FernletDomainModel, FernletFoundation) or either macOS script.
#      ProximityPlatformBoundaryTests pins its invocation, its default (on unless
#      SKIP_MACOS_BUILD_CHECK=1) and that its pattern covers the manifest and FernletFoundation's sources.
#
# githooks(5) passes the ref updates on stdin. They are read once, before either build leg decides
# whether it is relevant, so a skipped leg never hides the other.
set -u

REPO_ROOT="$(git rev-parse --show-toplevel)"

if [ "${SKIP_P10_SCAN:-0}" = "1" ]; then
  echo "[pre-push] SKIP_P10_SCAN=1 — skipping Power-of-10 scan (CI still enforces it)."
else
  echo "[pre-push] Running Power-of-10 mechanical scan (Scripts/power-of-10-scan.py)…"
  if ! python3 "$REPO_ROOT/Scripts/power-of-10-scan.py"; then
    echo "[pre-push] Power-of-10 scan FAILED — push aborted."
    echo "           Fix the listed violations (Docs/Power-of-10-Swift.md), or add a reviewed allowlist"
    echo "           entry with a stated invariant; bypass once with: SKIP_P10_SCAN=1 git push."
    exit 1
  fi
  echo "[pre-push] Power-of-10 scan passed."
fi

wall_relevant_regex='^(FernletKit/Package\.(swift|resolved)|FernletKit/Sources/|App/.*\.swift|Tests/.*\.swift|App/Fernlet\.xcodeproj/project\.pbxproj|App/Fernlet\.xcodeproj/project\.xcworkspace/xcshareddata/swiftpm/Package\.resolved|App/Fernlet\.xcodeproj/xcshareddata/xcschemes/|Fernlet\.xcworkspace/|.*\.xcprivacy|Scripts/spm-wall-check\.sh|Scripts/spm-wall-selftest\.sh)'
macos_relevant_regex='^(FernletKit/Package\.(swift|resolved)|FernletKit/Sources/(FernletCrypto|FernletDomainModel|FernletFoundation)/|Scripts/macos-build-(check|selftest)\.sh)'
zero="0000000000000000000000000000000000000000"

changed_files=""
undetermined=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  # Branch deletion (local sha all zeros): nothing to build.
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    # New branch on the remote: diff from its merge-base with origin/HEAD; if unknown, force the checks.
    base="$(git merge-base "$local_sha" origin/HEAD 2>/dev/null || true)"
    if [ -z "$base" ]; then
      undetermined=1
      continue
    fi
    range="$base..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  if files="$(git diff --name-only "$range" 2>/dev/null)"; then
    changed_files="$changed_files
$files"
  else
    undetermined=1
  fi
done

# Leg 2: the S3 privacy-wall check.
if [ "${SKIP_S3_WALL_CHECK:-0}" = "1" ]; then
  echo "[pre-push] SKIP_S3_WALL_CHECK=1 — skipping S3 wall check (CI still enforces it)."
elif [ "$undetermined" -eq 0 ] && ! printf '%s\n' "$changed_files" | grep -Eq "$wall_relevant_regex"; then
  echo "[pre-push] No S3-wall-relevant changes in this push — skipping wall check."
else
  echo "[pre-push] Running S3 privacy-wall check (Scripts/spm-wall-check.sh)…"
  "$REPO_ROOT/Scripts/spm-wall-check.sh"
  code=$?
  if [ "$code" -ne 0 ]; then
    echo "[pre-push] S3 wall check FAILED (exit $code) — push aborted."
    echo "           Fix the cross-wall import (look for 'is missing a dependency on') or the compiler"
    echo "           warning-turned-error (Power-of-10 rule 10: the strict build treats every warning,"
    echo "           including hidden package warnings, as an error),"
    echo "           or bypass once with: SKIP_S3_WALL_CHECK=1 git push   (CI still enforces it)."
    exit "$code"
  fi
  echo "[pre-push] S3 wall check passed."
fi

# Leg 3: the Mac-ready set on native macOS.
if [ "${SKIP_MACOS_BUILD_CHECK:-0}" = "1" ]; then
  echo "[pre-push] SKIP_MACOS_BUILD_CHECK=1 — skipping the macOS build check (CI still enforces it)."
elif [ "$undetermined" -eq 0 ] && ! printf '%s\n' "$changed_files" | grep -Eq "$macos_relevant_regex"; then
  echo "[pre-push] No change to the Mac-ready set in this push — skipping the macOS build check."
else
  echo "[pre-push] Running the macOS build check (Scripts/macos-build-check.sh)…"
  "$REPO_ROOT/Scripts/macos-build-check.sh"
  code=$?
  if [ "$code" -ne 0 ]; then
    echo "[pre-push] macOS build check FAILED (exit $code) — push aborted."
    echo "           The Mac-ready set no longer builds for native macOS 26: an iOS-only API reached"
    echo "           it, or a warning that only a macOS build reports appeared (see the check's message),"
    echo "           or bypass once with: SKIP_MACOS_BUILD_CHECK=1 git push   (CI still enforces it)."
    exit "$code"
  fi
  echo "[pre-push] macOS build check passed."
fi
exit 0
