{
  "sourceLanguage" : "en",
  "strings" : {
    "%lld bpm · aim %lld–%lld" : {
      "comment" : "Guided cardio, Live Activity and runner: the live heart rate in beats per minute and the target range to aim for, e.g. '118 bpm · aim 110–125'. Gentle: 'aim', never a limit.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld bpm · aim %2$lld–%3$lld"
