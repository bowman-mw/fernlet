{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fernlet"
          }
        }
      }
    },
    "Fernlet Recipe" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Receta de Fernlet"
          }
        }
      }
    },
    "Fernlet Workout Plan" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plan de entrenamiento de Fernlet"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fernlet looks through your calendar for flights, so their arcs and tickets fill in by themselves. It reads only the date, airports and times of flight events, on this iPhone, and never changes your calendar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fernlet busca vuelos en tu calendario para que sus arcos y billetes se completen solos. Solo lee la fecha, los aeropuertos y las horas de los vuelos, en este iPhone, y nunca cambia tu calendario."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fernlet uses your camera to scan barcodes and nutrition labels, photograph meals, take progress photos, and take photos during sessions with friends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fernlet usa la cámara para escanear códigos de barras e información nutricional, fotografiar comidas, tomar fotos de progreso y tomar fotos en sesiones con amigos."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fernlet uses Face ID to unlock your private health data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fernlet usa Face ID para desbloquear tus datos privados de salud."
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fernlet reads selected Health data only when you enable it — including workouts, body metrics, sleep, recovery, heart rate during guided cardio, and (optionally) cycle data — to give you a complete, on-device picture of your wellbeing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fernlet lee los datos de Salud que elijas solo cuando lo activas (entrenamientos, medidas del cuerpo, sueño, recuperación, frecuencia cardiaca durante el cardio guiado y, si quieres, datos del ciclo) para darte una imagen completa de tu bienestar, sin salir de tu dispositivo."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fernlet writes the workouts and health observations you explicitly log into Apple Health, so they appear in Apple Fitness and across your devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fernlet guarda en Salud los entrenamientos y los datos de salud que registras tú, para que aparezcan en Fitness y en todos tus dispositivos."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fernlet connects directly with nearby friends to share recipes and, during a session you start, photos, short-lived messages and hearts. A session may continue in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fernlet se conecta directamente con amigos cerca para compartir recetas y, durante una sesión que inicias tú, fotos, mensajes que duran poco y corazones. Una sesión puede seguir en segundo plano."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With background mapping on, Fernlet uncovers the map from the places you visit and the roads you drive or ride. It stays on this iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Con el mapeo en segundo plano activado, Fernlet descubre el mapa con los lugares que visitas y las carreteras por las que conduces o vas en bici. Todo se queda en este iPhone."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your companion lives on a map of where you are. The map uncovers as you go, and the history stays on this iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu compañero vive en un mapa de dónde estás. El mapa se descubre mientras vas, y el historial se queda en este iPhone."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fernlet uses motion to tell when you're riding a bike or in a car, only while \"Log my bike rides\" is on. It stays on this iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fernlet usa el movimiento para saber cuándo vas en bici o en coche, solo mientras \"Registrar mis salidas en bici\" está activado. Todo se queda en este iPhone."
          }
        }
      }
    },
    "NSNearbyInteractionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fernlet uses Ultra Wideband to measure the distance to a nearby friend while you connect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fernlet usa la banda ultraancha para medir la distancia a un amigo cercano mientras se conectan."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fernlet saves the shared pictures you choose after a friend session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fernlet guarda las fotos compartidas que elijas después de una sesión con amigos."
          }
        }
      }
    },
    "WorldWalk" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precise location draws the line of this walk or run. The line stays on this iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La ubicación precisa dibuja la línea de esta caminata o carrera. La línea se queda en este iPhone."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
