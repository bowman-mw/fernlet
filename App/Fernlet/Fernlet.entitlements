<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- NSPersistentCloudKitContainer's silent pushes need this key. Xcode writes "development" here
	     and substitutes "production" from the distribution profile at archive/export, so it is never
	     hand-edited. -->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.declared-age-range</key>
	<true/>
	<key>com.apple.developer.default-data-protection</key>
	<string>NSFileProtectionComplete</string>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<!-- World build (world-ui) only: the owner's data lives in CloudKit's PRODUCTION environment (the
	     TestFlight app's), and a development-signed run from Xcode would otherwise use Development
	     and see none of it. CloudKit reads this key at runtime (CKContainer, "Testing Your Code Using
	     the Development Container"); TestFlight and App Store builds use Production whatever it says.
	     The Simulator works only with Development, and INITIALIZE_CLOUDKIT_SCHEMA cannot write
	     Production, so a schema push needs this set back to Development first
	     (Docs/CloudKit-Schema-Deploy.md). Pinned by WorldIdentityBoundaryTests. -->
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.MBO.Fernlet</string>
	</array>
	<!-- CloudDocuments and the ubiquity container below stay although the app opens no document
	     container: the iCloud-availability check reads FileManager.ubiquityIdentityToken
	     (Persistence.swift, PrivacyDataSettingsView.swift, MultiDeviceSyncWarning), and that token
	     needs the iCloud Documents entitlement. Removing either would silently turn sync off for
	     every user (owner decision 2026-10-15). -->
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.MBO.Fernlet</string>
	</array>
	<key>com.apple.developer.weatherkit</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.MBO.Fernlet</string>
	</array>
	<key>com.apple.security.hardened-process</key>
	<true/>
	<key>com.apple.security.hardened-process.checked-allocations</key>
	<true/>
	<key>com.apple.security.hardened-process.checked-allocations.soft-mode</key>
	<true/>
	<key>com.apple.security.hardened-process.dyld-ro</key>
	<true/>
	<key>com.apple.security.hardened-process.enhanced-security-version-string</key>
	<string>1</string>
	<key>com.apple.security.hardened-process.hardened-heap</key>
	<true/>
	<key>com.apple.security.hardened-process.platform-restrictions-string</key>
	<string>2</string>
</dict>
</plist>
