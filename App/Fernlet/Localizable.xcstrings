    },
    "privacy.ownPhotos.bindingDisclosure" : {
      "comment" : "Privacy & Data: the last paragraph of the encrypted photo backup's consent alert. Turning the backup on is what eventually locks the photos' key to this iPhone.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Once your photos are safely in the backup, Fernlet locks their encryption key to this device, so a copy of your device backup can't open them. That can't be undone, and from then on this encrypted backup is how they come back on a new phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuando tus fotos ya estén a salvo en la copia de seguridad, Fernlet vincula su clave de cifrado a este dispositivo, así que una copia de seguridad de tu dispositivo no puede abrirlas. Eso no se puede deshacer, y desde entonces esta copia de seguridad cifrada es la forma de recuperarlas en un teléfono nuevo."
          }
        }
      }
    },
    "privacy.ownPhotos.sizeDisclosure" : {
      "comment" : "Privacy & Data: under the encrypted photo backup switch, and the first paragraph of its consent alert. The sizes are approximate; keep the numbers.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your meal, recipe and progress photos, encrypted. Fernlet doesn't limit how many photos you keep, so this can use a lot of your iCloud storage — roughly 150–400 KB per photo, which is 100–250 MB or more for a big library. Only photos that changed are uploaded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tus fotos de comidas, recetas y progreso, cifradas. Fernlet no limita cuántas fotos guardas, así que esto puede usar mucho de tu almacenamiento de iCloud: unos 150–400 KB por foto, es decir, 100–250 MB o más en una fototeca grande. Solo se suben las fotos que cambiaron."
          }
        }
      }
    },
    "privacy.ownPhotos.verifiedUnreadable" : {
      "comment" : "Privacy & Data: the encrypted photo backup's verification pass could not read this many photos. Needs a plural variation; the one-photo English says 'so it may be missing'.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Couldn't read %lld of your photos while verifying your encrypted backup, so it may be missing from iCloud or out of date there. Copies already backed up were kept. Tap Retry to verify again."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Couldn't read %lld of your photos while verifying your encrypted backup, so some may be missing from iCloud or out of date there. Copies already backed up were kept. Tap Retry to verify again."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "Fernlet no pudo leer %lld de tus fotos al verificar tu copia de seguridad cifrada, así que podría faltar en iCloud o estar desactualizada ahí. Lo que ya estaba en la copia de seguridad se conservó. Toca Reintentar para verificar de nuevo."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "Fernlet no pudo leer %lld de tus fotos al verificar tu copia de seguridad cifrada, así que algunas podrían faltar en iCloud o estar desactualizadas ahí. Lo que ya estaba en la copia de seguridad se conservó. Toca Reintentar para verificar de nuevo."
                }
              }
            }
          }
        }
      }
    },
    "privacy.sealedBackup.disclosure.appleCantRead" : {
      "comment" : "Encrypted backup consent alert, second paragraph: 'it' is the encrypted backup.",
