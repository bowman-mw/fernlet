    "You've drunk %@ of water. Please don't picture it." : {
      "comment" : "Companion line about water",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Te has tomado %@ de agua. Mejor no te lo imagines."
          }
        }
      }
    },
    "You've eaten %@ of a hen's whole year of work. She says you're welcome." : {
      "comment" : "Companion line about eggs",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Te has comido el %@ de todo un año de trabajo de una gallina. Dice que de nada."
          }
        }
      }
    },
    "You've eaten %@ of banana, end to end. I measured." : {
      "comment" : "Companion line about bananas",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Te has comido %@ de plátano, uno tras otro. Lo medí."
          }
        }
      }
    },
    "You've eaten ^[%@ hen-year](inflect: true) of eggs. The hens are unionizing." : {
      "comment" : "Companion line about eggs",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Te has comido los huevos de ^[%@ año](inflect: true) de una gallina. Las gallinas ya están formando un sindicato."
          }
        }
      }
    },
    "You've joined" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Te uniste"
          }
        }
      }
    },
    "You've moved %@ so far. Gently, I hope." : {
      "comment" : "Companion line about weight lifted",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hasta ahora has movido %@. Con cuidado, espero."
          }
        }
      }
    },
    "You've moved a lot recently, so this may just be that good kind of tired." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Te has movido mucho últimamente, así que quizá solo sea ese cansancio del bueno."
          }
        }
      }
    },
    "You've picked outside the range a few times. What's up?" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elegiste un peso fuera del rango varias veces. ¿Qué pasa?"
          }
        }
      }
    },
    "You've saved %lld locations — remove one to add another." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Guardaste %lld lugares — quita uno para agregar otro."
          }
        }
      }
    },
    "You've set your own calorie target, so the deficit isn't used. Clear the Calories field to use it again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fijaste tu propio objetivo de calorías, así que no se usa el déficit. Borra el campo Calorías para volver a usarlo."
          }
        }
      }
    },
    "You've slept ^[%@ koala day](inflect: true). The koalas approve." : {
      "comment" : "Companion line about sleep",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Has dormido ^[%@ día](inflect: true) de koala. Los koalas lo aprueban."
          }
        }
      }
    },
    "You've walked a whole Hamlet. Bravo." : {
      "comment" : "Companion line when the To Step or Not to Step stamp is earned (as many steps as Hamlet has words)",
      "localizations" : {
        "es" : {
          "stringUnit" : {
