          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una mezcla flexible de comidas y snacks."
          }
        }
      }
    },
    "A friend's shop opens here for an hour after you part. Report an item from its ··· menu." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La tienda de un amigo se abre aquí durante una hora después de despedirse. Reporta un artículo desde su menú ···."
