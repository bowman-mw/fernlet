    },
    "journal.dailyPrompt.emotions.6" : {
      "comment" : "Journal sheet: the daily inspiration prompt (naming a feeling), a gentle question the user may start an entry from",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "What did you feel today that you didn't say out loud?"
