    },
    "Private note saved, but Apple Health was not updated: %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nota privada guardada, pero Salud no se actualizó: %@"
          }
        }
      }
    },
    "Private opens with a tap while no passcode is set. Add a passcode to be asked for it before Private opens." : {
      "comment" : "The App lock settings page with no app passcode: what the Private tab does now, and what adding a passcode changes. Must not call the no-passcode state locked, protected or secured.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Privado se abre con un toque mientras no haya un código. Agrega un código para que Fernlet te lo pida antes de abrir Privado."
          }
        }
      }
    },
    "Private opens with a tap." : {
      "comment" : "Subtitle under 'No passcode' on the App lock settings page: with no app passcode, the Private tab opens with one tap on its Unlock button.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Privado se abre con un toque."
          }
        }
      }
    },
    "Private will open with a tap instead. Your entries stay encrypted on this iPhone and nothing is deleted. %@ unlock, your duress code and any recovery device are removed." : {
      "comment" : "Message of the confirmation before the app passcode is turned off. The placeholder is Face ID or Touch ID (an Apple product name). Nothing is deleted: the entries stay encrypted on this iPhone, and the Private tab opens with a tap afterwards.",
      "localizations" : {
        "es" : {
