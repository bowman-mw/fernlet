    "sealedBackup.restore.rolledBack" : {
      "comment" : "Privacy & Data: the Sealed backup in iCloud is older than this iPhone's copy, so it was not restored. The placeholder is a mid-sentence backup noun such as 'period' or 'photo'.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The %@ backup in iCloud is older than one this device already has, so Fernlet didn't restore it — that shouldn't happen on its own. Nothing was changed. If you still have this data on another device, back it up again from there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La copia de seguridad de %@ en iCloud es más antigua que una que este dispositivo ya tiene, así que Fernlet no la restauró; eso no debería pasar por sí solo. No se cambió nada. Si todavía tienes estos datos en otro dispositivo, vuelve a hacer la copia de seguridad desde ahí."
          }
        }
      }
    },
