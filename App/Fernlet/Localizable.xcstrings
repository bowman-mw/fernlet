    "duress.mode.silentWipe.armTitle" : {
      "comment" : "Title of the confirmation before the erase response is set as the duress code's response.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Arm the erase response?"
          }
        },
        "es" : {
          "stringUnit" : {
