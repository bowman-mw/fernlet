    "A cup! I'm starting a tower." : {
      "comment" : "Companion line when the Bean Counter stamp is earned (first coffee or tea)",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¡Una taza! Voy a empezar una torre."
