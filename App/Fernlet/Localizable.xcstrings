        }
      }
    },
    "Iron" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hierro"
          }
        }
      }
    },
    "It came from Health, so manage it in the Health app." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Viene de Salud, así que adminístralo en la app Salud."
          }
        }
      }
    },
    "It can't be reopened, but anything you kept is already saved." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se puede reabrir, pero todo lo que conservaste ya está guardado."
          }
        }
      }
    },
    "It comes off your personal care list. Days you've already ticked it stay as they are." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se quitará de tu lista de cuidado personal. Los días en que ya la marcaste se quedan como están."
          }
        }
      }
    },
    "It leaves your closet and your companion. This can't be undone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Desaparecerá de tu clóset y de tu compañero. Esta acción no se puede deshacer."
          }
        }
      }
    },
    "It stays on your Private panel." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se queda en tu panel Privado."
          }
        }
      }
    },
    "It stays on your Private tab." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se queda en tu pestaña Privado."
          }
        }
      }
    },
    "It won't be logged — you can plan it again any time." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se registrará — puedes volver a planearlo cuando quieras."
          }
        }
      }
    },
    "It works even while Fernlet is counting down from too many wrong attempts, and it never counts as a wrong attempt itself." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Funciona incluso mientras Fernlet hace la cuenta regresiva por demasiados intentos fallidos, y nunca cuenta como un intento fallido."
          }
        }
      }
    },
    "It's a meal photo" : {
      "extractionState" : "stale",
      "localizations" : {
