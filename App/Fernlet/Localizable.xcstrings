    "settings.appLock.reset.message.v2" : {
      "comment" : "Message in the Reset app lock confirmation in Settings. Keep it identical to the lock screen's own reset confirmation. The journal and intimacy backups restore only into an empty store, so the sentence tells the user to restore before adding new entries.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your journal, cycle history and intimacy entries saved in Fernlet will be permanently deleted. Anything Fernlet copied to Apple Health stays there. If Sealed backup is on, restore it from Privacy & Data afterwards, before you add new entries."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu diario, tu historial del ciclo y tus registros de intimidad guardados en Fernlet se eliminarán de forma permanente. Lo que Fernlet haya copiado a Salud se queda ahí. Si la Copia de seguridad sellada está activada, restáurala desde Privacidad y datos después, antes de agregar registros nuevos."
          }
        }
      }
    },
    "settings.appLock.reset.whereYouveBeen" : {
      "comment" : "Last line of the Reset app lock confirmation in Settings: the reset also deletes the 30-day timeline of places kept in Private (its Where you've been page), for good. Owner-approved wording, 2026-10-25. Keep it identical to the lock screen's.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
