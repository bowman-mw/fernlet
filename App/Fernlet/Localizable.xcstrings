        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La recomendación de la OMS para adultos es de al menos %1$@ minutos de actividad moderada a la semana, o %2$@ minutos de actividad intensa."
          }
        }
      }
    },
