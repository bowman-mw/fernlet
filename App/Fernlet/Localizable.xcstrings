    "duress.ceremony.done.destroyed" : {
      "comment" : "Recovery-device ceremony, last screen when the recovery device refused and asked for the data to be let go. 'Settings → App lock' names the screen.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your recovery device asked Fernlet to let this data go rather than return it. Nothing was recovered. You can start fresh from Settings → App lock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu dispositivo de recuperación le pidió a Fernlet que descartara estos datos en lugar de devolverlos. No se recuperó nada. Puedes empezar de cero desde Configuración → Bloqueo de la app."
          }
        }
      }
    },
    "duress.ceremony.done.enrolled" : {
      "comment" : "Recovery-device ceremony, last screen after enrolling a recovery device.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This phone is set up. Your other phone now holds the only key that can open it again — keep it somewhere you can reach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este teléfono está configurado. Tu otro teléfono ahora guarda la única clave que puede volver a abrirlo; guárdalo donde puedas tenerlo a mano."
          }
        }
      }
    },
    "duress.ceremony.done.recovered" : {
      "comment" : "Recovery-device ceremony, last screen after the key came back. 'Private' is the tab's name; 'App lock' is the Settings row's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your notes are back. Open the Private tab and enter your new passcode to see them — Face ID is off until you turn it back on in App lock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tus notas volvieron. Abre la pestaña Privado e ingresa tu código nuevo para verlas. Face ID está desactivado hasta que lo vuelvas a activar en Bloqueo de la app."
          }
        }
      }
    },
    "duress.ceremony.error.challengeResponseRejected" : {
      "comment" : "Recovery-device ceremony error: the other phone's answer code failed verification.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The other phone's answer didn't check out. Start again from the first code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La respuesta del otro teléfono no pasó la verificación. Empieza otra vez desde el primer código."
          }
        }
      }
    },
    "duress.ceremony.error.cryptoFailed" : {
      "comment" : "Recovery-device ceremony error: a signing step failed.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Something went wrong signing that step. Close this and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Algo salió mal al firmar ese paso. Cierra esto e inténtalo de nuevo."
          }
        }
      }
    },
    "duress.ceremony.error.enrollmentNotSaved" : {
      "comment" : "Recovery-device ceremony error: the passcode was accepted but no recovery device was saved.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "That passcode didn't set up a recovery device. Check it and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fernlet no pudo configurar un dispositivo de recuperación con ese código. Revísalo e inténtalo de nuevo."
          }
        }
      }
    },
    "duress.ceremony.error.identityUnavailable" : {
