      }
    },
    "journal.dailyPrompt.emotions.2" : {
      "comment" : "Journal sheet: the daily inspiration prompt (naming a feeling), a gentle question the user may start an entry from",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "What feeling visited you most today? No need to explain it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Qué emoción te visitó más hoy? No hace falta explicarla."
          }
        }
      }
    },
    "journal.dailyPrompt.emotions.3" : {
      "comment" : "Journal sheet: the daily inspiration prompt (naming a feeling), a gentle question the user may start an entry from",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Was there a moment today when your mood shifted? What was nearby?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Hubo un momento hoy en que cambió tu ánimo? ¿Qué había a tu alrededor?"
          }
        }
      }
    },
    "journal.dailyPrompt.emotions.4" : {
      "comment" : "Journal sheet: the daily inspiration prompt (naming a feeling), a gentle question the user may start an entry from",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "What's one word for how you feel right now — and one for how you'd like to feel tomorrow?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Con qué palabra describirías cómo te sientes ahora, y con cuál cómo te gustaría sentirte mañana?"
          }
        }
      }
    },
    "journal.dailyPrompt.emotions.5" : {
      "comment" : "Journal sheet: the daily inspiration prompt (naming a feeling), a gentle question the user may start an entry from",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Is anything sitting a little heavy tonight? You can just name it and stop there."
