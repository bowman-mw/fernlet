          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Es una foto de comida"
          }
        }
      }
    },
    "It's alright. Just start typing…" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Está bien. Solo empieza a escribir…"
          }
        }
      }
    },
    "It's in Settings → Period & sensitive content whenever you want to change it." : {
      "localizations" : {
        "es" : {
