    "journal.dailyPrompt.body.1" : {
      "comment" : "Journal sheet: the daily inspiration prompt (a body check-in), a gentle question the user may start an entry from",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Where in your body do you feel today the most?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿En qué parte del cuerpo sientes más el día de hoy?"
          }
        }
      }
    },
    "journal.dailyPrompt.body.2" : {
      "comment" : "Journal sheet: the daily inspiration prompt (a body check-in), a gentle question the user may start an entry from",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "What did your body do for you today that deserves a thank-you?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Qué hizo tu cuerpo por ti hoy que merezca un agradecimiento?"
          }
        }
      }
    },
    "journal.dailyPrompt.body.3" : {
      "comment" : "Journal sheet: the daily inspiration prompt (a body check-in), a gentle question the user may start an entry from",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "How tired are you, honestly? What kind of tired is it?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Qué tan ^[cansado](inflect: true) estás, de verdad? ¿Qué tipo de cansancio es?"
          }
        }
      }
    },
    "journal.dailyPrompt.body.4" : {
      "comment" : "Journal sheet: the daily inspiration prompt (a body check-in), a gentle question the user may start an entry from",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "What would feel kind to your body right now?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Qué le haría bien a tu cuerpo ahora mismo?"
          }
        }
      }
    },
    "journal.dailyPrompt.body.5" : {
      "comment" : "Journal sheet: the daily inspiration prompt (a body check-in), a gentle question the user may start an entry from",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When did you feel most at ease in your body today?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Cuándo te sentiste más a gusto en tu cuerpo hoy?"
          }
        }
      }
    },
    "journal.dailyPrompt.body.6" : {
      "comment" : "Journal sheet: the daily inspiration prompt (a body check-in), a gentle question the user may start an entry from",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "What's one thing your body has been quietly asking for?"
