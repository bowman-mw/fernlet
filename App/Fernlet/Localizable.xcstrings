        }
      }
    },
    "If workouts collide" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si los entrenamientos coinciden"
          }
        }
      }
    },
    "If you use Fernlet on another device, this reaches it the next time that device syncs — and a device you're using right then may re-add its most recent days and any custom clothing designs it still has." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si usas Fernlet en otro dispositivo, esto le llegará la próxima vez que se sincronice, y un dispositivo que estés usando en ese momento podría volver a agregar sus días más recientes y los diseños de ropa personalizados que todavía tenga."
          }
        }
      }
    },
    "If you went outside the range, why?" : {
      "comment" : "Edit workout: question above the reasons a lifter picked a weight outside the range Fernlet suggested (Too heavy, Too light, Equipment, Pain, Preference, Other). Optional.",
