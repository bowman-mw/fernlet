            "value" : "Intimidad"
          }
        }
      }
    },
    "Intimacy surfaces are hidden and Fernlet isn't reading them. Your notes are kept — turn this back on any time. Entries in Apple Health stay there either way." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las secciones de intimidad están ocultas y Fernlet no las está leyendo. Tus notas se conservan: vuelve a activar esto cuando quieras. Los registros en Salud se quedan ahí de todos modos."
          }
        }
      }
    },
    "Intimacy tracking" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seguimiento de intimidad"
          }
        }
      }
    },
    "Intimacy tracking was just hidden in Settings, so this entry wasn't saved. You can turn it back on any time to keep logging." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El seguimiento de intimidad se acaba de ocultar en Configuración, así que este registro no se guardó. Puedes volver a activarlo cuando quieras para seguir registrando."
          }
        }
      }
    },
    "Intimate logging" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
