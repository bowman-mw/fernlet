    "logPeriod.error.bufferFull.v2" : {
      "comment" : "Shown above Save on the period log sheet when the entries Fernlet holds until Private next opens have reached their limit. Opening the Private tab files them and makes room. 'Private' is the tab's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fernlet is holding your recent entries until you next open Private, so this one wasn't saved. Your entry is still here. Open Private once, then save this again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fernlet está guardando tus registros recientes hasta la próxima vez que abras Privado, así que este no se guardó. Tu registro sigue aquí. Abre Privado una vez y luego vuelve a guardarlo."
          }
        }
      }
    },
    "logPeriod.error.bufferUnopenable.v2" : {
      "comment" : "Shown above Save on the period log sheet when the entries Fernlet holds until Private next opens were sealed under a key that no longer exists, so a new one cannot join them. Opening the Private tab shows what can't be opened and offers to remove it. 'Private' is the tab's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fernlet can't add to the entries it's holding for Private, so this entry wasn't saved. Your entry is still here. Open Private to sort this out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fernlet no puede agregar más registros a los que guarda para Privado, así que este no se guardó. Tu registro sigue aquí. Abre Privado para resolverlo."
          }
        }
      }
    },
    "logPeriod.error.hidden" : {
      "comment" : "Shown above Save on the period log sheet when cycle tracking was hidden in Settings while the sheet was open, so nothing was saved.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Period tracking was just hidden in Settings, so this entry wasn't saved. Your entry is still here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El seguimiento del periodo se acaba de ocultar en Configuración, así que este registro no se guardó. Tu registro sigue aquí."
          }
        }
      }
    },
    "logPeriod.error.notEncrypted" : {
      "comment" : "Shown above Save on the period log sheet when the entry could not be encrypted this instant. Nothing was saved, and nothing went to Apple Health.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This iPhone couldn't encrypt your entry just now, so nothing was saved. Your entry is still here. Try again in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este iPhone no pudo cifrar tu registro justo ahora, así que no se guardó nada. Tu registro sigue aquí. Inténtalo de nuevo en un momento."
          }
        }
      }
    },
    "logPeriod.error.privateClosed" : {
      "comment" : "Shown above Save when an edit of a cycle day could not be saved because the Private tab closed while the sheet was open. 'Private' is the tab's name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Private closed before this could be saved, so nothing was changed. Open Private, then save again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Privado se cerró antes de que esto se pudiera guardar, así que no se cambió nada. Abre Privado y vuelve a guardar."
          }
        }
      }
    },
    "logPeriod.error.storeFull" : {
      "comment" : "Shown above Save on the period log sheet when the cycle history already holds as many entries as Fernlet keeps (20,000), so nothing was saved.",
