    },
    "A feature film of dreams. I'd watch it." : {
      "comment" : "Companion line when the Opening Night stamp is earned (two hours of dream sleep)",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un largometraje de sueños. Yo lo vería."
