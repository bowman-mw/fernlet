          }
        }
      }
    },
    "duress.mode.silentWipe.detail" : {
      "comment" : "Duress code screen: the full consequence of the erase response, shown when it is selected and again in its confirmation. Every claim is load-bearing; translate it whole, never shorten it.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Entering your duress code destroys the keys to your sealed journal, cycle and intimacy notes before anything appears on screen. This cannot be undone, and it cannot be recovered from a backup. Fernlet then opens as a brand-new empty app whose passcode is the duress code you just typed, so there is no duress code left until you set a new one. Fernlet also clears the sealed entries, your Apple Health cycle and intimacy entries, and its cloud copies in the background — copies already sent to a friend's phone or sitting in a backup are unreadable, but they exist until that clearing or their own expiry reaches them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Al ingresar tu código de coacción, se destruyen las claves de tus notas selladas del diario, del ciclo y de intimidad antes de que aparezca nada en la pantalla. Esto no se puede deshacer ni recuperar desde una copia de seguridad. Después, Fernlet se abre como una app nueva y vacía cuyo código es el código de coacción que acabas de ingresar, así que no queda ningún código de coacción hasta que configures uno nuevo. Además, Fernlet borra en segundo plano las entradas selladas, tus registros del ciclo y de intimidad en Salud, y sus copias en la nube. Las copias que ya se enviaron al teléfono de un amigo o que están en una copia de seguridad no se pueden leer, pero existen hasta que ese borrado las alcance o hasta que caduquen."
          }
        }
      }
    },
    "duress.mode.silentWipe.summary" : {
      "comment" : "Duress code screen: the one-line summary under 'Erase everything, then show an empty Fernlet'.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your sealed notes become permanently unreadable, immediately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tus notas selladas se vuelven ilegibles para siempre, al instante."
          }
        }
