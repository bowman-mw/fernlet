    "signal.explanation.eatingPattern" : {
      "comment" : "Trends: how the Eating pattern signal is worked out.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Looks at meal frequency, recent missed meal days, and protein totals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tiene en cuenta la frecuencia de las comidas, los días recientes en que faltó alguna comida y el total de proteína."
          }
        }
      }
    },
    "signal.explanation.energyTrend" : {
      "comment" : "Trends: how the Energy trend signal is worked out.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Combines sleep, journal tags, and recent workout load."
