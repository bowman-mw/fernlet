        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Combina el sueño, las etiquetas del diario y la carga reciente de entrenamiento."
          }
        }
      }
    },
    "signal.explanation.intensityReadiness" : {
