    },
    "journal.dailyPrompt.emotions.1" : {
      "comment" : "Journal sheet: the daily inspiration prompt (naming a feeling), a gentle question the user may start an entry from",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If today had a weather report, what would it say?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si el día de hoy tuviera su pronóstico del tiempo, ¿qué diría?"
