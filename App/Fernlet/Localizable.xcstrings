    },
    "Your CPD is %@. Scientists (me) are thrilled." : {
      "comment" : "Companion line about cookies per day",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu GPD es de %@. Los científicos (yo) están encantados."
