    "deleteAll.failure" : {
      "comment" : "Shown when a delete-everything wipe came back incomplete. The argument is the list of stores that failed. Deliberately does NOT promise a retry fixes everything — records already gone from the outbox cannot be reached again.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fernlet deleted everything it could, but couldn't finish: %@. Anything named there may still exist. Trying again can help for anything still on this phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fernlet borró todo lo que pudo, pero no pudo terminar: %@. Lo que se menciona ahí podría seguir existiendo. Volver a intentarlo puede servir para lo que siga en este teléfono."
          }
        }
      }
    },
    "deleteAll.health.integrationOff" : {
      "comment" : "Health paragraph of the delete-everything dialog when the Health integration is off but Fernlet previously wrote samples.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Health is turned off in Fernlet, but anything Fernlet wrote to Apple Health before that is still in Apple Health, and Fernlet can still delete it — you don't have to turn Health back on. It can only ever delete its own; everything else in Apple Health is yours to delete in the Health app. If you've taken Fernlet's Health access away since, it will say so instead of claiming it's gone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Salud está desactivada en Fernlet, pero todo lo que Fernlet guardó en Salud antes de eso sigue en Salud, y Fernlet aún puede eliminarlo; no hace falta que vuelvas a activar Salud. Solo puede eliminar sus propios registros; todo lo demás que hay en Salud puedes eliminarlo tú en la app Salud. Si desde entonces le quitaste a Fernlet el acceso a Salud, te lo dirá en lugar de afirmar que ya se eliminó."
          }
        }
      }
    },
    "deleteAll.health.integrationOn" : {
      "comment" : "Health paragraph of the delete-everything dialog when the Health integration is on.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fernlet can also delete the entries it wrote to Apple Health. It can only ever delete its own — everything else in Apple Health is yours to delete in the Health app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fernlet también puede eliminar los registros que guardó en Salud. Solo puede eliminar los suyos; todo lo demás que hay en Salud puedes eliminarlo tú en la app Salud."
          }
        }
      }
    },
    "deleteAll.health.nothingAuthored" : {
      "comment" : "Health paragraph of the delete-everything dialog when Fernlet has no record of authoring any Health samples.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fernlet has no record of writing anything to Apple Health, so it isn't offering to delete from there. If it wrote entries on an earlier install, turn Health back on to let Fernlet remove them, or delete them yourself in the Health app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fernlet no tiene constancia de haber guardado nada en Salud, así que no ofrece eliminar nada de ahí. Si guardó registros en una instalación anterior, vuelve a activar Salud para que Fernlet los elimine, o elimínalos tú en la app Salud."
          }
        }
      }
    },
    "deleteAll.keptOnPurpose" : {
      "comment" : "Third paragraph of the delete-everything dialog: exactly what survives the wipe, and the consequences of the new identity. Every clause here is load-bearing — see the code comment above it before changing any of them.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Kept on purpose: your shared photos — both the ones friends sent you and the ones you shared with them — and any restriction on sharing your own designs. You remove photos one at a time from the photo itself; there's no bulk delete. Your app lock stays set up. This phone gets a brand-new Fernlet identity, so friends' phones won't recognize it: you'll need to add each other again in person, and anyone you blocked will no longer be blocked — block them again if you meet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se conservan a propósito: tus fotos compartidas (tanto las que te enviaron tus amigos como las que tú compartiste con ellos) y cualquier restricción para compartir tus propios diseños. Las fotos se eliminan una por una desde la propia foto; no hay forma de eliminarlas todas a la vez. Tu bloqueo de la app sigue configurado. Este teléfono recibe una identidad de Fernlet completamente nueva, así que los teléfonos de tus amigos no lo reconocerán: tendrán que volver a agregarse en persona, y las personas que hayas bloqueado dejarán de estar bloqueadas; vuelve a bloquearlas si se encuentran."
          }
        }
      }
    },
    "deleteAll.multiDeviceCaveat" : {
      "comment" : "Second paragraph of the delete-everything dialog, shown only when an iCloud day copy exists. Discloses that an actively-used second device can re-upload recent days after the wipe.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you use Fernlet on another device, this reaches it the next time that device syncs — and a device you're using right then may re-add its most recent days and any custom clothing designs it still has."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si usas Fernlet en otro dispositivo, esto le llegará la próxima vez que se sincronice, y un dispositivo que estés usando en ese momento podría volver a agregar sus días más recientes y los diseños de ropa personalizados que todavía tenga."
          }
        }
      }
    },
    "deleteAll.scope.base.v2" : {
      "comment" : "First sentence of the delete-everything dialog. Enumerates every kind of user content the wipe removes; never shorten to a bare 'photos'. 'Cycle history' is every period entry saved in Fernlet (flow, temperature and the other fields, plus notes and symptoms), not only the notes. 'Photos from a Friends session you haven't chosen yet' are the in-person session photos still waiting in the keep-or-delete review; photos already kept stay (see the kept paragraph).",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This deletes your logged days, meals and their photos, gym progress photos, journal entries, cycle history, intimate logs, Worry Box notes, saved recipes and their photos, photos from a Friends session you haven't chosen yet, custom items and coins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esto borra tus días registrados, las comidas y sus fotos, las fotos de progreso del gimnasio, las entradas del diario, el historial del ciclo, los registros íntimos, las notas de la Caja de preocupaciones, las recetas guardadas y sus fotos, las fotos de una sesión de Amigos que todavía no hayas elegido, los artículos personalizados y las monedas."
          }
        }
      }
    },
    "deleteAll.scope.icloudCopy" : {
      "comment" : "Appended to the delete-everything scope only when a day-record copy exists in iCloud.",
      "extractionState" : "extracted_with_value",
