    },
    "Tap each size you have." : {
      "comment" : "Location editor, Weights I have: how to use the kettlebell size chips",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toca cada peso que tengas."
