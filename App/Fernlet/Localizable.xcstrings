    },
    "Every stamp found" : {
      "comment" : "Sprout's passport: the chip on a full passport",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Todos los sellos"
          }
        }
      }
