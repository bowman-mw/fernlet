    "Every bit of care you've logged, added up over all time." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Todo el cuidado que has registrado, sumado desde el principio."
