    "journal.dailyPrompt.gratitude.1" : {
      "comment" : "Journal sheet: the daily inspiration prompt (gratitude), a gentle question the user may start an entry from",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "What's one small thing today that you'd quietly like to keep?"
          }
