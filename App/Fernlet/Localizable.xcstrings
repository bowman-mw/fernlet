          }
        }
      }
    },
    "The passport can't be opened right now. Unlock your iPhone and try again." : {
      "comment" : "Airports: the passport couldn't be read or saved",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ahora no se puede abrir el pasaporte. Desbloquea el iPhone y vuelve a intentarlo."
