    "Tap a slot to change it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toca una opción para cambiarla."
          }
        }
      }
    },
    "Tap anywhere when you're ready for the next one — take all the time you like." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toca en cualquier parte cuando estés ^[listo](inflect: true) para el siguiente. Tómate todo el tiempo que necesites."
