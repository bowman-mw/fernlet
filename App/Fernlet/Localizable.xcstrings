          }
        }
      }
    },
    "duress.mode.recoveryLock.detail" : {
      "comment" : "Duress code screen: the full consequence of the recovery-lock response, shown when it is selected and again in its confirmation. Every claim is load-bearing; translate it whole, never shorten it.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Entering your duress code destroys this phone's passcode, Face ID and keys, but keeps your sealed notes. Nobody holding this phone can open them — including you. They can be opened again only in person, with the recovery device you enrolled below. If that device is lost, erased, or reinstalls Fernlet, your sealed notes are gone for good."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Al ingresar tu código de coacción, se destruyen el código, Face ID y las claves de este teléfono, pero se conservan tus notas selladas. Nadie que tenga este teléfono puede abrirlas, ni siquiera tú. Solo se pueden volver a abrir en persona, con el dispositivo de recuperación que configuraste abajo. Si ese dispositivo se pierde, se borra o reinstala Fernlet, tus notas selladas se pierden para siempre."
          }
        }
      }
    },
    "duress.mode.recoveryLock.summary" : {
      "comment" : "Duress code screen: the one-line summary under 'Lock it away on your recovery device'.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This phone loses its way in. Only your recovery device can open it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Este teléfono se queda sin forma de abrirse. Solo tu dispositivo de recuperación puede volver a abrirlo."
          }
        }
      }
    },
    "duress.mode.recoveryLock.title" : {
      "comment" : "Duress code response: the duress code locks this phone out; only the user's recovery device (another phone) can give the key back.",
