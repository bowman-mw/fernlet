{
  "sourceLanguage" : "en",
  "strings" : {
    "share.error.noURL" : {
      "comment" : "Shown by the system share UI when Fernlet cancels a share that carried no usable recipe URL, in either the attachments or the plain text.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fernlet could not find a recipe URL in this share."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fernlet no ha encontrado la URL de una receta en lo que has compartido."
          }
        }
      }
    },
    "shareQueue.error.invalidURL" : {
      "comment" : "Shown by the system share UI when the shared item is not an http or https URL.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fernlet can only import web recipe URLs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fernlet solo puede importar URL de recetas web."
          }
        }
      }
    },
    "shareQueue.error.urlTooLong" : {
      "comment" : "Shown by the system share UI when the shared URL is longer than the import queue will persist.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "That link is too long for Fernlet to import."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese enlace es demasiado largo para que Fernlet lo importe."
          }
        }
      }
    }
  },
  "version" : "1.0"
}