              }
            }
          }
        }
      }
    },
    "messages.recipe.notePreview" : {
      "comment" : "Preview line quoting the sender's recipe note. %@ is the note itself, truncated to 120 characters by the caller.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Note: %@"
