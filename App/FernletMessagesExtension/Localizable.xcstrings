{
  "sourceLanguage" : "en",
  "strings" : {
    "messages.action.browseLibrary" : {
      "comment" : "Button expanding the compact composer, shown before the catalog has loaded and so before the kind of item is known. The two kind-specific forms are messages.action.browseRecipes and messages.action.browseWorkouts.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Browse your library"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Explorar tu biblioteca"
          }
        }
      }
    },
    "messages.action.browseRecipes" : {
      "comment" : "Button expanding the compact composer to the full recipe list. A whole sentence rather than 'Browse your %@' on purpose: the noun cannot be spliced into a possessive in every language.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Browse your recipes"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Explorar tus recetas"
          }
        }
      }
    },
    "messages.action.browseWorkouts" : {
      "comment" : "Button expanding the compact composer to the full workout list. Sibling of messages.action.browseRecipes — see that comment for why the noun is not interpolated.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Browse your workouts"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Explorar tus entrenamientos"
          }
        }
      }
    },
    "messages.action.review" : {
      "comment" : "Button on a RECEIVED item. It opens the Fernlet app to look the item over before saving — it does not save anything by itself, and must not be translated as 'Save' or 'Import'.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Review in Fernlet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Revisar en Fernlet"
          }
        }
      }
    },
    "messages.action.share" : {
      "comment" : "Button inserting the selected item into the Messages conversation. The ↗ arrow is decorative and may be dropped if it reads badly in this language.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Share ↗"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Compartir ↗"
          }
        }
      }
    },
    "messages.brand" : {
      "comment" : "Wordmark above the composer title. 'Fernlet' is the product name and must NOT be translated; the ⌁ glyph and the two spaces are the mark's fixed typography. Translate only if the product ships under a different name in this language.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "⌁  FERNLET"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "⌁  FERNLET"
          }
        }
      }
    },
    "messages.card.notesIncluded" : {
      "comment" : "Trailing caption on the sent recipe card, telling the recipient a written note travels with it. Keep it short — Messages truncates this corner hard.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Notes included"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Incluye notas"
          }
        }
      }
    },
    "messages.card.opensInFernlet" : {
      "comment" : "Small line in the lower-right corner of every sent recipe or workout card. Every recipient reads it, including one whose device cannot open the card (no Fernlet, an older Fernlet, an iPad or a Mac), so it says where the card opens, neutrally, without instructions. 'Fernlet' is the product name and must NOT be translated; 'iPhone' is Apple's product name. Keep it short — Messages truncates this corner hard.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Opens in Fernlet on iPhone"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se abre en Fernlet para iPhone"
          }
        }
      }
    },
    "messages.card.plan" : {
      "comment" : "Trailing caption on a sent workout card when the sender set no display name of their own. Keep it short — Messages truncates this corner hard.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fernlet plan"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plan de Fernlet"
          }
        }
      }
    },
    "messages.card.recipe" : {
      "comment" : "Trailing caption on a sent recipe card carrying no note. Keep it short — Messages truncates this corner hard.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fernlet recipe"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Receta de Fernlet"
          }
        }
      }
    },
    "messages.card.selected" : {
      "comment" : "VoiceOver value spoken for the currently chosen catalog card. Spoken after the card's name, as a state — not a button label.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Selected"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Seleccionado"
          }
        }
      }
    },
    "messages.card.summaryText" : {
      "comment" : "The card's accessibility/notification summary — what Messages reads aloud and shows in a notification preview. %@ is the item's own title.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fernlet: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fernlet: %@"
          }
        }
      }
    },
    "messages.card.wordmark.recipe" : {
      "comment" : "Wordmark DRAWN INTO the card artwork the recipient sees in the conversation. Rendered at 28pt into a 1200×630 image, so a much longer translation will not fit; upper case matches the mark. 'Fernlet' is the product name and must not be translated.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "FERNLET RECIPE"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "RECETA DE FERNLET"
          }
        }
      }
    },
    "messages.card.wordmark.workout" : {
      "comment" : "Workout counterpart of messages.card.wordmark.recipe — same 28pt width limit and the same untranslated product name.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "FERNLET WORKOUT"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ENTRENAMIENTO DE FERNLET"
          }
        }
      }
    },
    "messages.error.openRecipe" : {
      "comment" : "Shown when the recipe reached the hand-off inbox but the Fernlet app would not open. Distinct from messages.error.prepareRecipe: here the item IS waiting, and opening the app by hand will find it.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fernlet couldn't open this recipe for review."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fernlet no pudo abrir esta receta para revisarla."
          }
        }
      }
    },
    "messages.error.openWorkout" : {
      "comment" : "Workout counterpart of messages.error.openRecipe — the plan IS waiting in the hand-off inbox.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fernlet couldn't open this workout plan for review."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fernlet no pudo abrir este plan de entrenamiento para revisarlo."
          }
        }
      }
    },
    "messages.error.prepareItem" : {
      "comment" : "Shown when the review button is pressed but neither a recipe nor a workout is held — the kind is unknown, hence the generic 'item'.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fernlet couldn't prepare this item for review."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fernlet no pudo preparar este elemento para revisarlo."
          }
        }
      }
    },
    "messages.error.prepareRecipe" : {
      "comment" : "Shown when the received recipe could not be written to the hand-off inbox the app reads. Nothing was saved.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fernlet couldn't prepare this recipe for review."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fernlet no pudo preparar esta receta para revisarla."
          }
        }
      }
    },
    "messages.error.prepareWorkout" : {
      "comment" : "Workout counterpart of messages.error.prepareRecipe. Nothing was saved.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fernlet couldn't prepare this workout plan for review."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fernlet no pudo preparar este plan de entrenamiento para revisarlo."
          }
        }
      }
    },
    "messages.hint.browse" : {
      "comment" : "VoiceOver hint on the browse button. 'Bounded' is meaningful: the extension can only ever see a capped catalog the app prepared, never the whole library.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Shows the full bounded Fernlet Messages catalog."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Muestra todo el catálogo limitado de Fernlet para Mensajes."
          }
        }
      }
    },
    "messages.hint.insert" : {
      "comment" : "VoiceOver hint on the share button. It adds the item to the conversation's draft; it does not send the message.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Adds the selected Fernlet item to this Messages conversation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Agrega el elemento de Fernlet seleccionado a esta conversación de Mensajes."
          }
        }
      }
    },
    "messages.hint.review" : {
      "comment" : "VoiceOver hint on the review button. 'Before saving' is the point — nothing is saved until the person confirms inside the Fernlet app.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Opens Fernlet to review this item before saving it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abre Fernlet para revisar este elemento antes de guardarlo."
          }
        }
      }
    },
    "messages.invalid.preview" : {
      "comment" : "Reassurance under messages.invalid.status. The extension never writes anything on the failure path, and this says so.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No item was saved or imported."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se guardó ni se importó nada."
          }
        }
      }
    },
    "messages.invalid.status" : {
      "comment" : "Status line under messages.invalid.title, naming the two causes: a format this build does not understand, or damaged bytes.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The message data is unsupported or invalid."
