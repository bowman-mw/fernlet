# Claude Code local tooling (settings, scratch worktrees) — not part of the project
.claude/

# Swift Package Manager local build/metadata (FernletKit)
.build/
.swiftpm/

# Branded food catalog: the full ~364k On-Demand Resource DB (~170 MB) is NOT committed — it is
# regenerable via Scripts/branded-catalog/ and fetched at runtime as an ODR (see ODRAssets/README.md).
# The bundled base DB (FoodCatalog.sqlite, generics + 50k curated floor) IS committed.
ODRAssets/FoodCatalogBranded.sqlite
# Large intermediate conversion artifacts (regenerable from the USDA FDC download)
FoodDataSource/BrandedFoodItems.json
FoodDataSource/BrandedODRFoodItems.json

# Food catalog data-only rebuild output. The committed catalog is intentionally never replaced by
# the generator; every SQLite/report/log artifact lands below this ignored directory.
.food-catalog-build/

# Agent instruction files — local tooling context, not part of the shipped project
CLAUDE.md
AGENTS.md

# macOS Finder metadata
.DS_Store

# Stale root-level project stub: an Xcode window still open on the pre-restructure path
# recreates ./Fernlet.xcodeproj holding only UI state. The real project is App/Fernlet.xcodeproj.
/Fernlet.xcodeproj/

# UX-review screenshot sweeps: development-time reference only, regenerable from the app, and large
# (the 2026-08-16 sweep alone is ~92 MB of PNGs). They go stale the moment the UI changes, so they are
# kept locally and never committed. Consequence: the browsable index at
# Docs/design-refs/<review>/review.html renders broken images unless you have the local sweep — the
# ranked findings in Docs/UI-UX-Review-*.md are the durable record.
Docs/design-refs/*/shots/
